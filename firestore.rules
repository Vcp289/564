rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/rows/{rowId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/meta/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
